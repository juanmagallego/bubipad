{
  "name": "BubiPad",
  "short_name": "BubiPad",
  "description": "Bloc de notas avanzado basado en el editor Monaco, con pestañas múltiples, explorador de carpetas, vista previa Markdown, integración con GitHub y corrector ortográfico Hunspell.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "any",
  "lang": "es",
  "icons": [
    { "src": "icons/icon16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "icons/icon48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "icons/icon128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "icons/icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
